{
  "name": "admin-pos",
  "version": "1.0.0",
  "description": "Admin POS: ventas, inventario, caja y control desde MariaDB",
  "main": "electron/main.cjs",
  "type": "module",
  "private": true,
  "author": "Toto Tools",
  "scripts": {
    "servidor": "node server/start.mjs",
    "pc": "electron .",
    "pc:portable": "electron-builder --win portable --publish never",
    "pc:instalable": "electron-builder --win nsis --publish never",
    "pc:ambos": "electron-builder --win portable nsis --publish never",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "mysql2": "^3.11.3"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tototools.adminpos",
    "productName": "Admin POS",
    "copyright": "Copyright © Toto Tools",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "server/**",
      "www/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Admin POS",
      "uninstallDisplayName": "Admin POS",
      "artifactName": "Admin-POS-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["es_ES", "en_US"],
      "language": "3082"
    },
    "portable": {
      "artifactName": "Admin-POS-Portable-${version}.exe"
    }
  }
}
